{
  "name": "tel-local-time",
  "version": "1.0.0",
  "description": "Brave Manifest V3 content-script extension that shows local time on tel: link hover",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-zones": "node scripts/fetch-zones.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/fetch-zones.mjs && npm run typecheck && vite build && node scripts/check-no-network.mjs",
    "test": "vitest run",
    "check": "node scripts/check-no-network.mjs",
    "pretest": "node scripts/fetch-zones.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "libphonenumber-js": "^1.13.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
